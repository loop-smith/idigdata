# Website's own Supabase (currently unused; empty public schema, reserved for future)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Post-deploy SEO verification strings
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional same-origin allowlist extension for POST routes.
# Defaults already include idigdata.com, www.idigdata.com, localhost:3100, and 127.0.0.1:3100.
WEBSITE_ALLOWED_ORIGINS=

# Optional credential-free event ingest endpoint for websiteEvents.ts.
NEXT_PUBLIC_WEBSITE_EVENT_INGEST_URL=

# Cross-codebase bridge - idigdata-app Supabase CRM targets.
IDIGDATA_APP_SUPABASE_URL=
IDIGDATA_APP_SUPABASE_ANON_KEY=
# Optional server-side key. If present, /api/contact can return inserted CRM row IDs.
IDIGDATA_APP_SUPABASE_SERVICE_ROLE_KEY=

# Resend - transactional email for contact-form notifications.
# Free tier = 3000 emails/month. Key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
EMAIL_NOTIFY_TO=
EMAIL_NOTIFY_FROM=
