<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>idigdata — Engagement Roadmap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vollkorn:wght@600;700&family=Lora:ital,wght@1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* ===========================================================
     idigdata brand v4 (per paved/.claude/CLAUDE.md)
     Deep navy #142840 + Sun gold #FACC15 + Vollkorn Bold + Lora italic + Stone neutrals
     =========================================================== */
  :root {
    --navy: #142840;
    --navy-soft: #2A4060;
    --gold: #FACC15;
    --gold-deep: #D4A60E;
    --stone: #F5F1E8;
    --stone-deep: #D4C5A0;
    --stone-line: #E8E0CC;
    --text: #1F2937;
    --muted: #6B7280;
    --bg: #FAFAF8;
  }

  * { box-sizing: border-box; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 40px;
    line-height: 1.5;
  }

  h1, h2, h3, .display, .wordmark {
    font-family: 'Vollkorn', Georgia, serif;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Header */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--navy);
    padding-bottom: 16px;
    margin-bottom: 32px;
  }

  .wordmark {
    font-size: 32px;
    color: var(--navy);
  }

  .kicker {
    font-size: 13px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  /* Engagement meta */
  .engagement-meta {
    margin-bottom: 28px;
  }

  .engagement-meta h1 {
    font-size: 36px;
    color: var(--navy);
    margin: 0 0 8px;
    line-height: 1.1;
  }

  .engagement-meta .dates {
    font-size: 16px;
    color: var(--muted);
  }

  .engagement-meta .dates strong {
    color: var(--navy);
    font-weight: 600;
  }

  /* Timeline */
  .timeline-container {
    background: white;
    border: 1px solid var(--stone-line);
    border-radius: 4px;
    padding: 24px 16px 16px;
    margin-bottom: 32px;
    overflow-x: auto;
  }

  #timeline {
    width: 100%;
    height: auto;
    min-width: 900px;
    display: block;
  }

  /* Phase cards grid */
  .phases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }

  .phase-card {
    background: white;
    border: 1px solid var(--stone-line);
    border-radius: 4px;
    padding: 20px 22px;
    border-left: 4px solid var(--navy);
    display: flex;
    flex-direction: column;
  }

  .phase-card.pre-engagement {
    border-left-color: var(--muted);
    background: #FAFAF8;
  }

  .phase-card.go-live {
    border-left-color: var(--gold);
    background: #FEFCE8;
  }

  .phase-card.stable-state {
    border-left-color: var(--gold-deep);
  }

  .phase-card .num {
    font-family: 'Vollkorn', Georgia, serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }

  .phase-card.go-live .num {
    color: var(--gold-deep);
  }

  .phase-card h3 {
    font-size: 19px;
    color: var(--navy);
    margin: 2px 0 6px;
  }

  .phase-card .span {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--stone-line);
  }

  .phase-card .delivers-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 6px;
  }

  .phase-card ul {
    padding-left: 18px;
    margin: 0 0 14px;
    font-size: 13px;
  }

  .phase-card li {
    margin-bottom: 5px;
    color: var(--text);
  }

  .phase-card .vp {
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: var(--navy);
    border-top: 1px solid var(--stone-line);
    padding-top: 12px;
    margin-top: auto;
    line-height: 1.45;
  }

  /* Footer */
  .footer {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--stone-line);
    font-size: 11px;
    color: var(--muted);
    text-align: center;
    letter-spacing: 0.05em;
  }

  /* Print */
  @media print {
    body { padding: 20px; background: white; }
    .phases { grid-template-columns: repeat(2, 1fr); page-break-inside: avoid; }
    .phase-card { page-break-inside: avoid; }
    .timeline-container { page-break-inside: avoid; }
  }
</style>
</head>
<body>

<div class="header">
  <div class="wordmark">idigdata</div>
  <div class="kicker">Engagement Roadmap</div>
</div>

<div class="engagement-meta">
  <h1 id="engagement-name">—</h1>
  <div class="dates">
    Engagement: <strong id="start-date">—</strong> &rarr; <strong id="end-date">—</strong>
    &nbsp;&middot;&nbsp; Go-live: <strong id="golive-date">—</strong>
    &nbsp;&middot;&nbsp; Duration: <strong id="duration">—</strong>
  </div>
</div>

<div class="timeline-container">
  <svg id="timeline" viewBox="0 0 1100 320" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"></svg>
</div>

<div class="phases" id="phase-cards"></div>

<div class="footer">
  idigdata &middot; Engagement Roadmap &middot; Generated <span id="generated-date"></span>
</div>

<script>
/* ============================================================
   ENGAGEMENT CONFIG
   Edit this object to generate a new roadmap for a different
   engagement. Sprint length is 13 days (idigdata sprint discipline).
   ============================================================ */

const config = {
  engagementName: "Mid-Market Beverage Operator",
  engagementSubtitle: "Transformation engagement",
  startDate: "2026-07-01",     // Sprint 1, Day 1 (contract signed)
  goLiveDate: "2028-03-01",    // End of P5 — 20 months in (tier-1 landscape consolidated, agentics live)
  endDate: "2028-05-01",       // End of P6 — 22 months in (stable state + handoff complete)

  phases: [
    {
      num: "P0",
      name: "Pre-contract recon",
      sprints: "Pre-Sprint 1",
      isPreEngagement: true,
      durationMonths: 2,        // recon window before contract sign
      delivers: [
        "Services contract signed; 18-24 months funded",
        "Player map locked",
        "Skeleton Visios in hand (Systems Map + Beehive)",
        "CFO + IT-side LOTL diagnostics",
        "Dedicated PM path agreed"
      ],
      valueProp: "The CFO knew Rob was the real deal BEFORE signing. The recon work no one else does is the proof."
    },
    {
      num: "P1",
      name: "Discovery + funding case",
      sprints: "Sprints 1–4",
      durationMonths: 2,
      delivers: [
        "Full current-state map + co-created future-state",
        "Constellation+cluster maps for all six (MDM near-locked)",
        "Working beehive — taskforces per departmental lane",
        "MDM big three under build (customers · vendors · items+locations)",
        "Process Event work begun (BOSS Requirements Register seeded)",
        "Board-defensible multi-year capital program funding artifact",
        "30-60-90 to C-suite"
      ],
      valueProp: "What Big-4 takes 4–6 months and a 12-person team to produce, Rob delivers solo in 2 months. Speed AND accuracy. BOSS persistence-and-sequenced-build is the moat."
    },
    {
      num: "P2",
      name: "Architecture lock",
      sprints: "Sprints 5–8",
      durationMonths: 2,
      delivers: [
        "Common Data Model architecture locked",
        "Constellation maps mature to near-locked",
        "Beehive design ratified (architectural layer)",
        "Agile-fall mode plan locked",
        "Vendor selections committed",
        "Cross-C-suite sign-off"
      ],
      valueProp: "Vendor-agnostic, data-centric architecture. Most consultants paint over the ERP with reports; Rob extracts the data layer."
    },
    {
      num: "P3",
      name: "Data core + people fabric",
      sprints: "~6 months",
      durationMonths: 6,
      delivers: [
        "MDM operational (CDM alive)",
        "Beehive taskforces operating by functional system group",
        "Executive standoffs resolved",
        "IT-function rebuild underway",
        "Tier-1 systems audit + replacement plan locked"
      ],
      valueProp: "Data core comes alive BEFORE the systems landscape changes. The new tier-1 systems will feed the data core — not the other way around. The sequence IS the IP."
    },
    {
      num: "P4",
      name: "Tier-1 systems + CDM at scale + SOP generation",
      sprints: "~6 months",
      durationMonths: 6,
      delivers: [
        "ERP / WMS / CRM consolidation or replacement (build/test through UAT)",
        "Common Data Model fully operational at scale",
        "Vendor portfolio rationalized; vendor lock-in eliminated",
        "New systems plug into the data core",
        "Agentics integrated with tier-1 landscape (by design, not bolted on)",
        "SOP library auto-generated at BPS level from validated proof set (branded, version-controlled)",
        "E2E signoff — ready for go-live"
      ],
      valueProp: "Vendor lock-in elimination IS the strategic option. Permanent capability, not a one-time fix. Plus by P4 close: CDM operational at scale across the new tier-1 landscape, and the SOP library is already auto-generated from the validated proof set — branded, current, ready for the operators who will use the system tomorrow."
    },
    {
      num: "P5",
      name: "Go-live",
      sprints: "~4 months",
      durationMonths: 4,
      isGoLive: true,
      delivers: [
        "Mock go-lives + pressure testing",
        "Production cutover complete (the date)",
        "Tier-1 systems landscape live in production",
        "Agentic apps live in production at scale",
        "SOP library already in place (generated through UAT in P4) — operators have it on day one",
        "Operators using new fabric daily",
        "BOSS constellations green / green",
        "CEO's AI claim operationally real"
      ],
      valueProp: "Go-live is the moment the new operating fabric IS the operating fabric. Every thread that ran through P1–P4 — data core · tier-1 systems · agentics · beehive · governance · SOPs — converges into production at the same time. The transformation isn't abstract anymore; it runs the business. The operator-facing SOP library was generated from the validated proof set during P4; by go-live it's already on every operator's screen, fresher than the system itself."
    },
    {
      num: "P6",
      name: "Adoption + handoff",
      sprints: "~2 months",
      durationMonths: 2,
      isStableState: true,
      delivers: [
        "Frameworks documented; registers handed off",
        "Training delivered (operational CIO + in-house IT) using BOSS-generated SOP library",
        "BOSS substrate handed off (open-source, client-owned)",
        "Staleness loop institutionalized — SOPs stay current as side-effect of operating",
        "Cap-treatment discipline transferred",
        "No managed-services tail"
      ],
      valueProp: "Clean exit. Client institutionalizes. Break-clauses become irrelevant because the engagement reaches its natural end with everything transferred. The training material the operational CIO + in-house IT learn from was generated by BOSS itself during P5 — so the handoff is the same artifact set the operators already use."
    }
    /* P7 (post-engagement persistence) lives outside the engagement window — not on roadmap */
  ]
};

/* ============================================================
   RENDERING
   ============================================================ */

function fmtMY(d) {
  const dt = new Date(d + "T00:00:00");
  return dt.toLocaleDateString("en-US", { month: "short", year: "2-digit" });
}
function fmtFull(d) {
  const dt = new Date(d + "T00:00:00");
  return dt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
function addMonths(d, m) {
  const dt = new Date(d + "T00:00:00");
  dt.setMonth(dt.getMonth() + m);
  return dt.toISOString().split("T")[0];
}
function monthsBetween(a, b) {
  const da = new Date(a + "T00:00:00");
  const db = new Date(b + "T00:00:00");
  return (db.getFullYear() - da.getFullYear()) * 12 + (db.getMonth() - da.getMonth()) + (db.getDate() - da.getDate()) / 30;
}

// Compute durations
const totalMonths = Math.round(monthsBetween(config.startDate, config.endDate));
const goLiveMonths = Math.round(monthsBetween(config.startDate, config.goLiveDate));

// Populate header
document.getElementById("engagement-name").textContent =
  config.engagementName + " — " + (config.engagementSubtitle || "Transformation Engagement");
document.getElementById("start-date").textContent = fmtFull(config.startDate);
document.getElementById("end-date").textContent = fmtFull(config.endDate);
document.getElementById("golive-date").textContent = fmtFull(config.goLiveDate);
document.getElementById("duration").textContent =
  totalMonths + " months (" + goLiveMonths + " to go-live + " + (totalMonths - goLiveMonths) + " stable state)";
document.getElementById("generated-date").textContent =
  new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

// Compute phase boundaries
let cursor = config.startDate;
const phaseSpans = [];
config.phases.forEach(p => {
  if (p.isPreEngagement) {
    const start = addMonths(config.startDate, -p.durationMonths);
    phaseSpans.push({ ...p, start, end: config.startDate });
  } else {
    const start = cursor;
    const end = addMonths(cursor, p.durationMonths);
    phaseSpans.push({ ...p, start, end });
    cursor = end;
  }
});

// ===== Timeline SVG =====
const svg = document.getElementById("timeline");
const W = 1100, H = 320;
const padL = 50, padR = 30, padT = 90, padB = 60;
const innerW = W - padL - padR;

const allStarts = phaseSpans.map(p => p.start);
const earliest = allStarts.sort()[0];
const latest = config.endDate;
const totalSpan = monthsBetween(earliest, latest);

function dateToX(d) {
  const m = monthsBetween(earliest, d);
  return padL + (m / totalSpan) * innerW;
}

let s = "";

// Quarter gridlines + month axis
let mc = earliest;
while (monthsBetween(mc, latest) >= -0.01) {
  const dt = new Date(mc + "T00:00:00");
  const x = dateToX(mc);
  if (dt.getMonth() % 3 === 0) {
    s += `<line x1="${x}" y1="${padT}" x2="${x}" y2="${H - padB}" stroke="#E8E0CC" stroke-width="1"/>`;
    s += `<text x="${x}" y="${H - padB + 18}" text-anchor="middle" font-size="11" fill="#6B7280" font-family="Inter, sans-serif" font-weight="500">${fmtMY(mc)}</text>`;
  }
  mc = addMonths(mc, 1);
}
// Always include latest as last tick
const xL = dateToX(latest);
s += `<line x1="${xL}" y1="${padT}" x2="${xL}" y2="${H - padB}" stroke="#E8E0CC" stroke-width="1"/>`;
s += `<text x="${xL}" y="${H - padB + 18}" text-anchor="middle" font-size="11" fill="#6B7280" font-family="Inter, sans-serif" font-weight="500">${fmtMY(latest)}</text>`;

// Phase bars
const barH = 36;
const barY = padT + 30;
phaseSpans.forEach(p => {
  const x1 = dateToX(p.start);
  const x2 = dateToX(p.end);
  const w = Math.max(x2 - x1, 4);

  let fill = "#142840";       // navy default
  let textFill = "#FFFFFF";
  if (p.isPreEngagement) { fill = "#94A3B8"; textFill = "#FFFFFF"; }
  if (p.isGoLive)        { fill = "#FACC15"; textFill = "#142840"; }
  if (p.isStableState)   { fill = "#D4A60E"; textFill = "#142840"; }

  s += `<rect x="${x1}" y="${barY}" width="${w}" height="${barH}" fill="${fill}" rx="3"/>`;

  if (w > 50) {
    s += `<text x="${x1 + w/2}" y="${barY + barH/2 - 2}" text-anchor="middle" font-size="13" font-weight="700" fill="${textFill}" font-family="Vollkorn, Georgia, serif">${p.num}</text>`;
    s += `<text x="${x1 + w/2}" y="${barY + barH/2 + 12}" text-anchor="middle" font-size="10" fill="${textFill}" font-family="Inter, sans-serif" opacity="0.85">${p.name}</text>`;
  } else {
    s += `<text x="${x1 + w/2}" y="${barY - 4}" text-anchor="middle" font-size="11" font-weight="700" fill="#142840" font-family="Vollkorn, Georgia, serif">${p.num}</text>`;
  }
});

// Phase span dates below bars
phaseSpans.forEach(p => {
  if (p.isPreEngagement) return;
  const x1 = dateToX(p.start);
  const x2 = dateToX(p.end);
  if (x2 - x1 > 70) {
    s += `<text x="${(x1 + x2)/2}" y="${barY + barH + 18}" text-anchor="middle" font-size="10" fill="#6B7280" font-family="Inter, sans-serif">${fmtMY(p.start)} – ${fmtMY(p.end)}</text>`;
  }
});

// ===== Agentic thread sub-track =====
// Continuous gold band beneath phase bars showing the agentic thread intensifying
// across the engagement. P5 is go-live for the WHOLE transformation; agentics peak
// there because by P5 they've matured into production scale alongside everything else.
const agenticY = barY + barH + 38;
const agenticH = 14;
s += `<text x="${padL}" y="${agenticY - 6}" font-size="9" font-weight="700" fill="#142840" font-family="Inter, sans-serif" letter-spacing="0.1em">AGENTIC THREAD</text>`;
const agenticIntensity = { "P0": 0, "P1": 0.30, "P2": 0.55, "P3": 0.75, "P4": 0.85, "P5": 1.0, "P6": 0.40 };
const agenticSubLabels = { "P1": "readiness", "P2": "policy + stack", "P3": "deployment", "P4": "integration", "P5": "scale", "P6": "handoff" };
phaseSpans.forEach(p => {
  const x1 = dateToX(p.start);
  const x2 = dateToX(p.end);
  const w = Math.max(x2 - x1, 4);
  const intensity = agenticIntensity[p.num] || 0;
  if (intensity > 0) {
    s += `<rect x="${x1}" y="${agenticY}" width="${w}" height="${agenticH}" fill="#FACC15" fill-opacity="${intensity}" rx="2"/>`;
  } else {
    s += `<rect x="${x1}" y="${agenticY}" width="${w}" height="${agenticH}" fill="none" stroke="#D4C5A0" stroke-width="1" rx="2" stroke-dasharray="3,2" opacity="0.5"/>`;
  }
  const label = agenticSubLabels[p.num];
  if (label && w > 50) {
    s += `<text x="${x1 + w/2}" y="${agenticY + agenticH + 12}" text-anchor="middle" font-size="9" fill="#6B7280" font-family="Inter, sans-serif" font-style="italic">${label}</text>`;
  }
});

// Milestones
const milestones = [
  { date: config.startDate, label: "Contract sign", color: "#142840" },
  { date: config.goLiveDate, label: "Go-live",      color: "#FACC15", emphasis: true },
  { date: config.endDate,   label: "Engagement end", color: "#6B7280" }
];

milestones.forEach(m => {
  const x = dateToX(m.date);
  const stroke = m.color;
  s += `<line x1="${x}" y1="${padT - 24}" x2="${x}" y2="${barY + barH + 6}" stroke="${stroke}" stroke-width="${m.emphasis ? 2 : 1.5}" stroke-dasharray="4,3"/>`;
  // Diamond marker
  const cy = padT - 30;
  s += `<polygon points="${x-7},${cy} ${x},${cy-7} ${x+7},${cy} ${x},${cy+7}" fill="${stroke}"/>`;
  s += `<text x="${x}" y="${padT - 44}" text-anchor="middle" font-size="11" font-weight="700" fill="${stroke}" font-family="Inter, sans-serif">${m.label}</text>`;
  s += `<text x="${x}" y="${padT - 56}" text-anchor="middle" font-size="10" fill="${stroke}" font-family="Inter, sans-serif" opacity="0.85">${fmtMY(m.date)}</text>`;
});

svg.innerHTML = s;

// ===== Phase cards =====
const cardsContainer = document.getElementById("phase-cards");
cardsContainer.innerHTML = phaseSpans.map(p => {
  let cls = "phase-card";
  if (p.isPreEngagement) cls += " pre-engagement";
  if (p.isGoLive)        cls += " go-live";
  if (p.isStableState)   cls += " stable-state";

  const span = p.isPreEngagement
    ? `Pre-engagement · ${fmtMY(p.start)} – ${fmtMY(p.end)}`
    : `${p.sprints} · ${fmtMY(p.start)} – ${fmtMY(p.end)}`;

  return `
    <div class="${cls}">
      <div class="num">${p.num}${p.isGoLive ? " · GO-LIVE" : ""}${p.isStableState ? " · STABLE STATE" : ""}</div>
      <h3>${p.name}</h3>
      <div class="span">${span}</div>
      <div class="delivers-label">Delivers</div>
      <ul>${p.delivers.map(d => `<li>${d}</li>`).join("")}</ul>
      <div class="vp">${p.valueProp}</div>
    </div>
  `;
}).join("");
</script>
</body>
</html>
