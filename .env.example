# Website-own Supabase (reserved / light use — not the DigOps beacon sink)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Post-deploy SEO verification strings
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional same-origin allowlist extension for POST routes.
# Defaults already include idigdata.com, www.idigdata.com, localhost:3100, and 127.0.0.1:3100.
WEBSITE_ALLOWED_ORIGINS=

# Optional credential-free event ingest endpoint for websiteEvents.ts.
NEXT_PUBLIC_WEBSITE_EVENT_INGEST_URL=
# Default suppresses Vercel preview traffic from buyer-signal telemetry. Set to 1 only for intentional preview instrumentation.
NEXT_PUBLIC_TRACK_PREVIEW_TRAFFIC=
# Default captures entrance/door-knock traffic only. Set to 1 if page-to-page navigation telemetry is needed again.
NEXT_PUBLIC_TRACK_PAGE_NAVIGATION=

# DigOps (operations) Supabase bridge — contact intake + door-knock / pageviews.
DIGOPS_SUPABASE_URL=
DIGOPS_SUPABASE_ANON_KEY=
# Optional server-side key. If present, /api/contact can return inserted CRM row IDs.
DIGOPS_SUPABASE_SERVICE_ROLE_KEY=

# Beacon identity — keep Real hits clean (Vercel Production + Preview).
# Visit https://idigdata.com/?internal=1 once on your browser to stamp a year-long cookie.
# Visit https://idigdata.com/?fleet=1 (or ?agent=1) on agent browsers; clear with ?clear_fleet=1.
# Optional: comma-separated Operator/home IPs that always count as internal.
DIGOPS_INTERNAL_IPS=
# Optional shared secret for Playwright/fleet. Send header: x-digops-traffic: fleet:<secret>
DIGOPS_FLEET_BEACON_SECRET=

# Resend — transactional email for contact-form notifications.
RESEND_API_KEY=
EMAIL_NOTIFY_TO=
EMAIL_NOTIFY_FROM=
