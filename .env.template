# DigOps env template — idigdata-site
# Copy to .env.local / Vercel. Do not use retired IDIGDATA_APP_* names.

# Optional site-owned Supabase (unused as DigOps sink)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

WEBSITE_ALLOWED_ORIGINS=
NEXT_PUBLIC_WEBSITE_EVENT_INGEST_URL=
NEXT_PUBLIC_TRACK_PREVIEW_TRAFFIC=
# Set to 1 only to re-enable page-to-page pageviews + dwell/scroll.
NEXT_PUBLIC_TRACK_PAGE_NAVIGATION=

# DigOps bridge (required for door-knock + contact)
DIGOPS_SUPABASE_URL=
DIGOPS_SUPABASE_ANON_KEY=
# Optional — only needed to return contact lead UUIDs to the browser.
DIGOPS_SUPABASE_SERVICE_ROLE_KEY=
# Optional salt for hashed door-knock IPs (defaults to a fixed practice salt).
DIGOPS_IP_HASH_SALT=

DIGOPS_INTERNAL_IPS=
DIGOPS_FLEET_BEACON_SECRET=

RESEND_API_KEY=
EMAIL_NOTIFY_TO=
EMAIL_NOTIFY_FROM=
